<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --h:'Syncopate',sans-serif;
  --b:'Space Grotesk',sans-serif;
  --red:#FF2D2D;
  --orange:#FF6B00;
  --dark:#080808;
  --dark2:#111111;
  --card:#141414;
  --border:rgba(255,255,255,0.07);
  --muted:rgba(255,255,255,0.35);
}
html{scroll-behavior:smooth}
body{background:var(--dark);color:#fff;font-family:var(--b);overflow-x:hidden}

/* NAV */
.nav{display:flex;justify-content:space-between;align-items:center;padding:1.5rem 3rem;border-bottom:1px solid var(--border);position:sticky;top:0;background:rgba(8,8,8,0.97);backdrop-filter:blur(8px);z-index:100}
.logo{font-family:var(--h);font-size:1.1rem;letter-spacing:4px;text-transform:uppercase}
.logo span{color:var(--red)}
.nav-links{display:flex;gap:2.5rem;list-style:none}
.nav-links a{color:var(--muted);text-decoration:none;font-size:0.75rem;letter-spacing:2px;text-transform:uppercase;transition:color 0.2s}
.nav-links a:hover{color:#fff}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px}
.hamburger span{display:block;width:24px;height:1px;background:#fff;transition:all 0.3s}

/* HERO */
.hero{min-height:88vh;display:flex;flex-direction:column;justify-content:center;padding:5rem 3rem;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-20%;right:-10%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(255,45,45,0.08) 0%,transparent 70%);pointer-events:none}
.hero::after{content:'';position:absolute;bottom:-10%;left:20%;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(255,107,0,0.06) 0%,transparent 70%);pointer-events:none}
.eyebrow{font-size:0.7rem;letter-spacing:5px;text-transform:uppercase;color:var(--red);margin-bottom:1.5rem;display:flex;align-items:center;gap:0.75rem}
.eyebrow::before{content:'';display:block;width:30px;height:1px;background:var(--red)}
.hero h1{font-family:var(--h);font-size:clamp(2.8rem,8vw,7.5rem);line-height:1;letter-spacing:3px;text-transform:uppercase;margin-bottom:1.5rem;animation:fadeUp 0.8s ease both}
.hero h1 .slash{color:var(--red);margin:0 0.2rem}
.hero h1 .sub{display:block;font-size:0.45em;color:var(--muted);letter-spacing:6px;margin-top:0.5rem;font-family:var(--b);font-weight:300;text-transform:uppercase}
.hero p{font-size:1rem;color:var(--muted);max-width:500px;line-height:1.8;font-weight:300;margin-bottom:3rem;animation:fadeUp 0.8s 0.15s ease both}
.cta-row{display:flex;gap:1rem;align-items:center;flex-wrap:wrap;animation:fadeUp 0.8s 0.3s ease both}
.btn-red{background:var(--red);color:#fff;padding:0.9rem 2.25rem;border:none;border-radius:4px;font-family:var(--b);font-size:0.8rem;font-weight:500;cursor:pointer;letter-spacing:2px;text-transform:uppercase;transition:background 0.2s;text-decoration:none;display:inline-block}
.btn-red:hover{background:#cc2020}
.btn-outline{background:transparent;color:#fff;padding:0.9rem 2.25rem;border:1px solid rgba(255,255,255,0.2);border-radius:4px;font-family:var(--b);font-size:0.8rem;cursor:pointer;letter-spacing:2px;text-transform:uppercase;transition:border-color 0.2s;text-decoration:none;display:inline-block}
.btn-outline:hover{border-color:#fff}

/* STATS */
.stats-strip{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.stat{padding:2.5rem 3rem;border-right:1px solid var(--border)}
.stat:last-child{border-right:none}
.stat-num{font-family:var(--h);font-size:2.5rem;letter-spacing:1px;color:#fff;margin-bottom:0.25rem}
.stat-num span{color:var(--red)}
.stat-label{font-size:0.7rem;letter-spacing:2px;text-transform:uppercase;color:var(--muted)}

/* SECTIONS */
.section{padding:5rem 3rem;max-width:1200px;margin:0 auto}
.section-tag{display:inline-flex;align-items:center;gap:0.75rem;font-size:0.7rem;letter-spacing:4px;text-transform:uppercase;color:var(--red);margin-bottom:3rem}
.section-tag::after{content:'';display:block;width:40px;height:1px;background:var(--red)}
.section h2{font-family:var(--h);font-size:clamp(1.8rem,4vw,3rem);letter-spacing:3px;text-transform:uppercase;margin-bottom:0.5rem;line-height:1.1}

/* PLATFORMS */
.platforms{display:flex;flex-wrap:wrap;gap:0.6rem;margin-top:2.5rem}
.platform-pill{display:flex;align-items:center;gap:0.6rem;padding:0.65rem 1.4rem;border-radius:3px;font-size:0.8rem;font-weight:500;letter-spacing:1px;border:1px solid;transition:opacity 0.2s}
.platform-pill:hover{opacity:0.75}
.ig{background:rgba(228,64,95,0.08);border-color:rgba(228,64,95,0.25);color:#E4405F}
.yt{background:rgba(255,0,0,0.08);border-color:rgba(255,0,0,0.25);color:#FF0000}
.li{background:rgba(10,102,194,0.08);border-color:rgba(10,102,194,0.25);color:#5B9BD5}
.tw{background:rgba(255,255,255,0.05);border-color:rgba(255,255,255,0.15);color:#ccc}

/* SERVICES */
.services{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1px;background:var(--border);border:1px solid var(--border);margin-top:3rem}
.service-card{background:var(--card);padding:2rem;transition:background 0.2s;position:relative;overflow:hidden}
.service-card::before{content:'';position:absolute;top:0;left:0;width:2px;height:0;background:var(--red);transition:height 0.3s}
.service-card:hover::before{height:100%}
.service-card:hover{background:#1a1a1a}
.service-num{font-family:var(--h);font-size:0.65rem;letter-spacing:3px;color:var(--red);margin-bottom:1.25rem}
.service-card h3{font-size:0.9rem;font-weight:500;letter-spacing:1px;text-transform:uppercase;margin-bottom:0.75rem}
.service-card p{font-size:0.83rem;color:var(--muted);line-height:1.7;font-weight:300}

/* WORK GRID */
.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);margin-top:3rem}
.work-item{background:var(--card);padding:2.25rem;min-height:200px;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;transition:background 0.2s;position:relative;overflow:hidden;text-decoration:none;color:#fff}
.work-item:hover{background:#1c1c1c}
.work-item::after{content:'↗';position:absolute;top:1.5rem;right:1.5rem;font-size:1rem;color:var(--red);opacity:0;transition:opacity 0.2s}
.work-item:hover::after{opacity:1}
.work-platform{font-size:0.65rem;letter-spacing:3px;text-transform:uppercase;color:var(--muted);margin-bottom:0.5rem}
.work-title{font-family:var(--h);font-size:0.85rem;letter-spacing:1px;text-transform:uppercase;margin-bottom:auto;padding-bottom:1.5rem}
.work-metric{display:inline-flex;align-items:center;gap:0.4rem;font-size:0.75rem;font-weight:500;color:var(--red);border-top:1px solid var(--border);padding-top:1rem;width:100%}

/* CLIENTS */
.clients-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1.5rem;margin-top:3rem}
.client-card{background:var(--card);border:1px solid var(--border);border-radius:4px;padding:2.5rem;position:relative;transition:border-color 0.3s}
.client-card.featured{border-color:rgba(255,45,45,0.3)}
.client-card:hover{border-color:rgba(255,45,45,0.5)}
.client-badge{display:inline-block;font-size:0.65rem;letter-spacing:3px;text-transform:uppercase;color:var(--red);border:1px solid rgba(255,45,45,0.3);padding:0.3rem 0.75rem;border-radius:2px;margin-bottom:1.5rem}
.client-logo{width:60px;height:60px;background:linear-gradient(135deg,var(--red),#FF6B00);border-radius:8px;display:flex;align-items:center;justify-content:center;font-family:var(--h);font-size:1.1rem;color:#fff;margin-bottom:1rem}
.client-name{font-family:var(--h);font-size:1.3rem;letter-spacing:3px;text-transform:uppercase;margin-bottom:1rem;color:#fff}
.client-desc{font-size:0.88rem;color:var(--muted);line-height:1.8;font-weight:300;margin-bottom:1.5rem}
.client-tags{display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:2rem}
.tag{font-size:0.65rem;letter-spacing:2px;text-transform:uppercase;color:var(--muted);border:1px solid var(--border);padding:0.3rem 0.75rem;border-radius:2px}
.client-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border)}
.metric{background:var(--dark);padding:1.25rem;text-align:center}
.metric-val{font-family:var(--h);font-size:1.4rem;color:var(--red);letter-spacing:1px}
.metric-lbl{font-size:0.62rem;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-top:0.25rem}

/* TESTIMONIAL */
.testimonial{border:1px solid var(--border);padding:3rem;margin-top:3rem;position:relative;background:var(--card)}
.testimonial::before{content:'\201C';font-family:var(--h);font-size:8rem;color:var(--red);opacity:0.15;position:absolute;top:-2rem;left:2rem;line-height:1}
.testimonial p{font-size:1.05rem;font-weight:300;font-style:italic;line-height:1.8;color:rgba(255,255,255,0.65);margin-bottom:2rem}
.testimonial-author{display:flex;align-items:center;gap:1rem;border-top:1px solid var(--border);padding-top:1.5rem}
.avatar{width:44px;height:44px;border-radius:3px;background:var(--red);display:flex;align-items:center;justify-content:center;font-family:var(--h);font-size:0.75rem;color:#fff;flex-shrink:0}
.author-name{font-size:0.9rem;font-weight:500}
.author-role{font-size:0.75rem;color:var(--muted);margin-top:0.2rem}

/* CONTACT */
.contact-section{padding:0 3rem 5rem;max-width:1200px;margin:0 auto}
.contact-block{background:var(--dark2);border:1px solid var(--border);padding:4rem 3rem;text-align:center;position:relative;overflow:hidden}
.contact-block::before{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(255,45,45,0.06) 0%,transparent 70%);pointer-events:none}
.contact-eyebrow{font-size:0.7rem;letter-spacing:5px;text-transform:uppercase;color:var(--red);margin-bottom:1rem;display:flex;align-items:center;justify-content:center;gap:0.75rem}
.contact-eyebrow::before,.contact-eyebrow::after{content:'';display:block;width:30px;height:1px;background:var(--red)}
.contact-block h2{font-family:var(--h);font-size:clamp(2rem,5vw,4rem);letter-spacing:4px;text-transform:uppercase;margin-bottom:1rem;line-height:1.1}
.contact-block > p{color:var(--muted);margin-bottom:2.5rem;font-weight:300;position:relative}
.socials{display:flex;justify-content:center;gap:0.75rem;margin-top:2rem;flex-wrap:wrap}
.social-btn{padding:0.6rem 1.4rem;border:1px solid var(--border);color:var(--muted);font-size:0.75rem;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:border-color 0.2s,color 0.2s;background:transparent;border-radius:3px;font-family:var(--b)}
.social-btn:hover{border-color:var(--red);color:var(--red)}

/* FOOTER */
footer{text-align:center;padding:2rem 3rem;color:rgba(255,255,255,0.15);font-size:0.72rem;letter-spacing:2px;border-top:1px solid var(--border)}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}

/* MOBILE */
@media(max-width:900px){
  .stats-strip{grid-template-columns:repeat(2,1fr)}
  .work-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:700px){
  .nav{padding:1rem 1.5rem}
  .nav-links{display:none;position:fixed;top:60px;left:0;right:0;background:#080808;flex-direction:column;padding:2rem;gap:1.5rem;border-bottom:1px solid var(--border)}
  .nav-links.open{display:flex}
  .hamburger{display:flex}
  .hero{padding:3rem 1.5rem 2rem;min-height:auto}
